# Locally, use PORT=4000 and CLIENT_ORIGIN=http://localhost:5173.
# Hosting providers usually provide PORT automatically.
PORT=<port>
MONGODB_URI=<your-mongodb-connection-string>
CLIENT_ORIGIN=<your-frontend-origin>
# Optional workaround for network DNS resolvers that refuse MongoDB Atlas SRV queries:
# MONGODB_DNS_SERVERS=8.8.8.8
JWT_SECRET=<your-long-random-server-only-secret>
